# Booking form delivery.
# Leave these unset in development: the form still validates and returns success,
# and the submission is logged to the server console instead of being emailed.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where booking enquiries are delivered.
BOOKING_TO_EMAIL=ari@circleshotcreations.com

# Verified Resend sender. Must be on a domain you've verified with Resend.
BOOKING_FROM_EMAIL=bookings@circleshotcreations.com
